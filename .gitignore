# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------- 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------------- 临时与备份
*.tmp
*.bak
*~
*.orig

# ---------------------------------------------------------------- WorkBuddy
# memory/ 是项目记忆，需要纳入版本管理；只排除运行时缓存类文件
.workbuddy/*.db
.workbuddy/sessions/
.workbuddy/tmp/
.workbuddy/cache/

# ---------------------------------------------------------------- 旧仓库备份
# 重建仓库时留下的旧 .git 副本，确认无需回退后可整个删除
.git_backup_*/

# ---------------------------------------------------------------- PPT 中间产物
# build_pptx.py 把 SVG 光栅化后的缓存，删除后重新生成即可
# ⚠️ 模式含中间斜杠时是相对 .gitignore 所在目录的，必须写 **/ 才能匹配任意层级
**/ppt/_png/
