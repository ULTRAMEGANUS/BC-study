# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# ---------------------------------------------------------------- 系统文件
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# ---------------------------------------------------------------- 编辑器 / IDE
.vscode/
.idea/
*.swp
*.swo

# ---------------------------------------------------------------- 临时与备份
*.tmp
*.bak
*~
*.orig

# ---------------------------------------------------------------- WorkBuddy
# 记忆文件是过程性产物（每次会话都会变），不进版本库。
# 原因：① 会持续让工作区变脏，反复触发"提交还是丢弃"的噪音；
#      ② 一旦误回滚，会连带丢失已做的记忆精简（2026-09-18 发生过一次）。
# 磁盘上仍然保留，只是不受 git 追踪。
.workbuddy/memory/
.workbuddy/*.db
.workbuddy/sessions/
.workbuddy/tmp/
.workbuddy/cache/

# ---------------------------------------------------------------- 旧仓库备份
# 重建仓库时留下的旧 .git 副本，确认无需回退后可整个删除
.git_backup_*/

